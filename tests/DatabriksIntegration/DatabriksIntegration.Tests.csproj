        </Reference>
        <Reference Include="Terrasoft.Sync">
            <HintPath>$(TestCoreLibPath)/Terrasoft.Sync.dll</HintPath>
            <SpecificVersion>False</SpecificVersion>
            <Private>True</Private>
        </Reference>
        <Reference Include="Terrasoft.GlobalSearch">
            <HintPath>$(TestCoreLibPath)/Terrasoft.GlobalSearch.dll</HintPath>
            <SpecificVersion>False</SpecificVersion>
            <Private>True</Private>
        </Reference>
        <Reference Include="Creatio.FeatureToggling">
            <HintPath>$(TestCoreLibPath)/Creatio.FeatureToggling.dll</HintPath>
            <SpecificVersion>False</SpecificVersion>
            <Private>True</Private>
        </Reference>
        <Reference Include="Common.Logging">
            <HintPath>$(TestCoreLibPath)/Common.Logging.dll</HintPath>
            <SpecificVersion>False</SpecificVersion>
            <Private>True</Private>
        </Reference>
        <Reference Include="Common.Logging.Core">
            <HintPath>$(TestCoreLibPath)/Common.Logging.Core.dll</HintPath>
            <SpecificVersion>False</SpecificVersion>
            <Private>True</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\packages\DatabriksIntegration\Files\DatabriksIntegration.csproj"/>
        <!-- Referenced by HintPath in the package, which does not flow to this project. -->
        <Reference Include="ErrorOr">
            <HintPath>..\..\packages\DatabriksIntegration\Files\Libs\ErrorOr.dll</HintPath>
        </Reference>
        <Reference Include="Databricks.Zerobus">
            <HintPath>..\..\packages\DatabriksIntegration\Files\Libs\Databricks.Zerobus.dll</HintPath>
        </Reference>
        <!-- In-box on .NET 8; on .NET Framework it comes from the Creatio core binaries. -->
        <Reference Condition="'$(TargetFramework)' == 'net472'" Include="System.Text.Json">
            <HintPath>$(TestCoreLibPath)/System.Text.Json.dll</HintPath>
        </Reference>
        <Reference Condition="'$(TargetFramework)' == 'net472'" Include="System.IO.Compression" />
        <Reference Condition="'$(TargetFramework)' == 'net472'" Include="System.IO.Compression.FileSystem" />
    </ItemGroup>
</Project>
