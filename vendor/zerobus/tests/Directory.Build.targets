<Project>
  <!--
    Fork addition: the fork does not build Rust. Tests use the official prebuilt native library from the
    Databricks.Zerobus.Ingest.Sdk 0.1.0 NuGet package, copied next to the test assembly so default
    DllImport probing finds it.
  -->
  <!-- Fork addition: `-p:ZerobusTestNetFx=true` runs the unit tests on .NET Framework (x64 for the win-x64 library). -->
  <PropertyGroup Condition="'$(ZerobusTestNetFx)' == 'true' AND '$(MSBuildProjectName)' == 'Zerobus.Tests'">
    <TargetFrameworks>net472</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Databricks.Zerobus.Ingest.Sdk" Version="[0.1.0]" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetPackageRoot)' != ''">
    <None Include="$(NuGetPackageRoot)databricks.zerobus.ingest.sdk/0.1.0/runtimes/win-x64/native/zerobus_ffi.dll"
          Link="zerobus_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
